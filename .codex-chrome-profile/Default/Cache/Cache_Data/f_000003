                <td>{{ row.bankSuccessAmount | number : '1.0-2' }}</td>
                <td>{{ row.difference | number : '1.0-2' }}</td>
                <td>{{ row.decision }}</td>
              </tr>
              <tr *ngIf="compensationRows.length === 0"><td colspan="8">Aucune donnee de compensation.</td></tr>
            </tbody>
