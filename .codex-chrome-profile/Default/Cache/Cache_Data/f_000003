            <article class="dashboard-kpi-tile kpi-soft-red"><span class="label">Absent banque</span><strong>{{ riskAbsentBankCount }}</strong><small>Banque: {{ riskAbsentBankBankAmount | number : '1.0-2' }}</small><small>{{ activeOperatorLabel }}: {{ riskAbsentBankOperatorAmount | number : '1.0-2' }}</small></article>
