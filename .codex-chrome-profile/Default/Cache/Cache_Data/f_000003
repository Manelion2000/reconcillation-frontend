          <span>Nb tx Operateur: <b>{{ compensationPeriod.totalOperatorSuccessCount }}</b></span>
          <span>Nb tx Banque: <b>{{ compensationPeriod.totalBankSuccessCount }}</b></span>
          <span>Montant Operateur: <b>{{ compensationPeriod.totalOperatorSuccessAmount | number : '1.0-2' }}</b></span>
          <span>Montant Banque: <b>{{ compensationPeriod.totalBankSuccessAmount | number : '1.0-2' }}</b></span>
          <span>Ecart: <b>{{ compensationPeriod.totalDifference | number : '1.0-2' }}</b></span>
          <span>Decision: <b>{{ compensationPeriod.decision }}</b></span>
