          <span>Montant Banque: <b>{{ summary.montantGlobalBanque | number : '1.0-2' }}</b></span>
          <span>{{ counterpartAmountLabel }}: <b>{{ summary.montantGlobalMoov | number : '1.0-2' }}</b></span>
          <span>Total Global: <b>{{ globalAmountTotal | number : '1.0-2' }}</b></span>
          <span>Ecart Global: <b>{{ summary.ecartGlobal | number : '1.0-2' }}</b></span>
        </div>
        <div class="quick-filters">
          <button *ngFor="let q of quickFilters" class="quick-btn" [ngClass]="[q.className, selectedFilter === q.type ? 'active' : '']" (click)="applyQuickFilter(q.type)">
            <span>{{ q.label }}</span><strong>{{ q.count() }}</strong>
          </button>
        </div>
        <div class="kpis kpi-board">
          <article class="kpi success kpi-group">
            <span class="kpi-title">Performance {{ activeOperatorLabel }}</span>
            <strong>{{ summary.totalMatchOk }}</strong>
            <small>Matches</small>
            <div class="kpi-sub"><span>Taux de succes</span><b>{{ successRate | number : '1.1-1' }}%</b></div>
            <div class="kpi-sub"><span>Taux d'echec global</span><b>{{ failureRate | number : '1.1-1' }}%</b></div>
          </article>
          <article class="kpi warning kpi-group">
            <span class="kpi-title">Ecarts de montant</span>
            <strong>{{ summary.totalMontantDifferent }}</strong>
            <small>Lignes en ecart</small>
            <div class="kpi-sub"><span>Echec des deux cotes</span><b>{{ failureDoubleSideRate | number : '1.1-1' }}%</b></div>
            <div class="kpi-sub"><span>Debit a tort</span><b>{{ failureDebitRate | number : '1.1-1' }}%</b></div>
          </article>
          <article class="kpi danger kpi-group">
            <span class="kpi-title">Lignes manquantes</span>
            <strong>{{ missingTotal }}</strong>
            <small>Total manquants</small>
            <div class="kpi-sub"><span>Manquants Banque</span><b>{{ summary.totalAbsentBanque }} ({{ missingBankRate | number : '1.1-1' }}%)</b></div>
            <div class="kpi-sub"><span>Manquants {{ activeOperatorLabel }}</span><b>{{ summary.totalAbsentMoov }} ({{ missingMoovRate | number : '1.1-1' }}%)</b></div>
          </article>
          <article class="kpi info kpi-group">
            <span class="kpi-title">Anomalies metier</span>
            <strong>{{ summary.totalDoublons }}</strong>
            <small>Doublons detectes</small>
            <div class="kpi-sub"><span>Credit sans debit</span><b>{{ summary.totalCreditSansDebit }}</b></div>
            <div class="kpi-sub"><span>Debit a tort</span><b>{{ summary.totalDebitATort }}</b></div>
          </article>
        </div>
      </section>

      <section class="card result-card" *ngIf="summary && activePage === 'RECONCILIATION'">
        <h2>Resultats Banque / {{ activeOperatorLabel }}</h2>
        <div class="filters-panel">
          <div class="filters-head">
            <h3>Recherche et tri</h3>
            <button class="ghost" (click)="resetResultFilters()">Reinitialiser les filtres</button>
          </div>
          <div class="filters-grid">
            <label class="filter-field">Statut <select [(ngModel)]="selectedFilter" (change)="onFilterChange()"><option *ngFor="let f of filterOptions" [ngValue]="f">{{ f }}</option></select></label>
            <label class="filter-field">Type operation <select [(ngModel)]="operationFilter" (change)="onOperationFiltersChange()"><option *ngFor="let o of operationOptions" [ngValue]="o">{{ o }}</option></select></label>
            <label class="filter-field">Cle partagee <input type="text" [(ngModel)]="transactionKeyFilter" (input)="onTransactionKeyFilterChange()" placeholder="Coller la cle..." /></label>
            <label class="filter-field">Numero telephone <input type="text" [(ngModel)]="phoneFilter" (input)="onPhoneFilterChange()" placeholder="Ex: 226XXXXXXXX" /></label>
            <label class="filter-field">Numero compte <input type="text" [(ngModel)]="accountNumberFilter" (input)="onAccountNumberFilterChange()" placeholder="Ex: 1234567890" /></label>
            <label class="filter-field">Mode date operation <select [(ngModel)]="operationDateMode" (change)="onOperationFiltersChange()"><option [ngValue]="'SINGLE'">Date unique</option><option [ngValue]="'RANGE'">Entre deux dates</option></select></label>
            <label class="filter-field" *ngIf="operationDateMode === 'SINGLE'">Date operation <input type="date" [(ngModel)]="operationDateFilter" (change)="onOperationFiltersChange()" /></label>
            <label class="filter-field" *ngIf="operationDateMode === 'RANGE'">Date debut <input type="date" [(ngModel)]="operationDateFrom" (change)="onOperationFiltersChange()" /></label>
            <label class="filter-field" *ngIf="operationDateMode === 'RANGE'">Date fin <input type="date" [(ngModel)]="operationDateTo" (change)="onOperationFiltersChange()" /></label>
          </div>
        </div>
        <div class="table-tools">
          <div class="left-tools"><button class="tool excel" (click)="exportFilteredResultsExcel()">Excel</button></div>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Cle</th>
                <th>Type</th>
                <th>Direction</th>
                <th>Reference operation</th>
                <th>Nom complet</th>
                <th>MSISDN (Telephone)</th>
                <th>Numero de compte</th>
                <th>transactionDate (Banque)</th>
                <th>date ({{ activeOperatorLabel }})</th>
                <th>Montant Banque</th>
                <th>{{ counterpartAmountLabel }}</th>
                <th>Ecart</th>
                <th>Statut Banque</th>
                <th>{{ counterpartStatusLabel }}</th>
                <th>Motif rejet banque</th>
              </tr>
            </thead>
            <tbody>
              <tr *ngFor="let row of paginatedResults" [class.soft-failure-row]="isSoftFailureRow(row)">
                <td>{{ row.transactionKey }}</td>
                <td>{{ row.resultType }}</td>
                <td>{{ direction(row) }}</td>
                <td>{{ bankOperationReference(row) }}</td>
                <td>{{ bankFullName(row) }}</td>
                <td>{{ bankMsisdn(row) }}</td>
                <td>{{ bankAccountNumber(row) }}</td>
                <td>{{ bankDate(row) }}</td>
                <td>{{ counterpartDate(row) }}</td>
                <td>{{ row.bankAmount ?? '-' }}</td>
                <td>{{ row.moovAmount ?? '-' }}</td>
                <td>{{ row.amountDifference ?? '-' }}</td>
                <td>{{ row.bankStatusRaw ?? '-' }}</td>
                <td>{{ row.moovStatusRaw ?? '-' }}</td>
                <td>{{ bankRejectReason(row) }}</td>
              </tr>
              <tr *ngIf="filteredResults.length === 0"><td colspan="15">Aucune ligne trouvee pour {{ activeOperatorLabel }}.</td></tr>
            </tbody>
          </table>
        </div>
        <div class="table-pagination" *ngIf="filteredResults.length > 0">
          <button class="page-btn" (click)="goToPage(currentPage - 1)" [disabled]="currentPage <= 1">Precedent</button>
          <span>Page {{ currentPage }} / {{ totalPages }} ({{ filteredResults.length }} lignes)</span>
          <button class="page-btn" (click)="goToPage(currentPage + 1)" [disabled]="currentPage >= totalPages">Suivant</button>
        </div>

      </section>

      <section class="card dashboard-card full-page" *ngIf="dashboardSummary && activePage === 'DASHBOARD'">
        <h2>Dashboard KPI {{ activeOperatorLabel }}</h2>
        <div class="kpi-filter-bar">
          <label>Portee KPI (date transaction) <select [(ngModel)]="periodMode"><option value="SINGLE_DAY">Jour unique</option><option value="RANGE">Entre deux dates</option></select></label>
          <label *ngIf="periodMode === 'SINGLE_DAY'">Jour transaction <input type="date" [(ngModel)]="singleDay" /></label>
          <label *ngIf="periodMode === 'RANGE'">Date transaction debut <input type="date" [(ngModel)]="dateFrom" /></label>
          <label *ngIf="periodMode === 'RANGE'">Date transaction fin <input type="date" [(ngModel)]="dateTo" /></label>
          <button class="primary" (click)="applyKpiFilters()" [disabled]="loading">Appliquer</button>
          <button class="quick-range reset" (click)="resetHistoryFilter()">Reinitialiser</button>
        </div>
        <p class="kpi-scope">
          <span *ngIf="dashboardSummary.periodType === 'DAY'">Jour transaction: {{ dashboardSummary.businessDate }}</span>
          <span *ngIf="dashboardSummary.periodType === 'RANGE'">Periode transaction: {{ dashboardSummary.dateFrom }} -> {{ dashboardSummary.dateTo }}</span>
        </p>
        <div class="dashboard-kpi-strip">
          <article class="dashboard-kpi-tile kpi-soft-green">
            <span class="label">Transactions Banque</span>
            <strong>{{ dashboardSummary.totalBank }}</strong>
          </article>
          <article class="dashboard-kpi-tile kpi-soft-yellow">
            <span class="label">Transactions {{ activeOperatorLabel }}</span>
            <strong>{{ dashboardSummary.totalOperator }}</strong>
          </article>
          <article class="dashboard-kpi-tile kpi-soft-green">
            <span class="label">Matching Rate</span>
            <strong>{{ dashboardSummary.matchingRate | number : '1.0-2' }}%</strong>
          </article>
          <article class="dashboard-kpi-tile kpi-soft-yellow">
            <span class="label">Success Rate</span>
            <strong>{{ dashboardSummary.successRate | number : '1.0-2' }}%</strong>
          </article>
          <article class="dashboard-kpi-tile kpi-soft-orange">
            <span class="label">Anomaly Rate</span>
            <strong>{{ dashboardSummary.anomalyRate | number : '1.0-2' }}%</strong>
          </article>
          <article class="dashboard-kpi-tile kpi-soft-yellow">
            <span class="label">Total Results</span>
            <strong>{{ dashboardSummary.totalResults }}</strong>
          </article>
          <article class="dashboard-kpi-tile kpi-soft-orange">
            <span class="label">Montant Anomalies</span>
            <strong>{{ dashboardSummary.montantAnomalies | number : '1.0-2' }}</strong>
          </article>
          <article class="dashboard-kpi-tile kpi-soft-red">
            <span class="label">Ecart Global</span>
            <strong>{{ dashboardSummary.ecartGlobal | number : '1.0-2' }}</strong>
          </article>
        </div>

        <div class="dashboard-block reporting-block">
          <div class="reporting-head">
            <h3>Reporting Managerial (Journalier / Hebdo / Mensuel)</h3>
            <div class="reporting-actions">
              <label>Periode
                <select [(ngModel)]="reportingPeriodType">
                  <option [ngValue]="''">Choisir...</option>
                  <option value="DAY">Jour</option>
                  <option value="WEEK">Semaine</option>
                  <option value="MONTH">Mois</option>
                </select>
              </label>
              <label>Date reference <input type="date" [(ngModel)]="reportingReferenceDate" /></label>
              <button class="primary" (click)="loadReportingSummary()" [disabled]="reportingLoading || !reportingPeriodType || !reportingReferenceDate">Generer</button>
              <button class="ghost" (click)="resetReportingFilters()">Reinitialiser</button>
              <button class="secondary" (click)="exportReportingExcel()" [disabled]="!reportingSummary">Excel</button>
              <button class="secondary" (click)="exportReportingPdf()" [disabled]="!reportingSummary">PDF</button>
            </div>
          </div>
          <p class="kpi-scope">KPI reporting bases sur la date de transaction (et non la date metier).</p>

          <div class="dashboard-kpi-strip" *ngIf="reportingSummary?.kpis as r">
            <article class="dashboard-kpi-tile kpi-soft-green"><span class="label">Tx Total</span><strong>{{ r.totalTransactions }}</strong></article>
            <article class="dashboard-kpi-tile kpi-soft-green"><span class="label">Success Rate</span><strong>{{ r.successRate | number : '1.0-2' }}%</strong></article>
            <article class="dashboard-kpi-tile kpi-soft-orange"><span class="label">Anomaly Rate</span><strong>{{ r.anomalyRate | number : '1.0-2' }}%</strong></article>
            <article class="dashboard-kpi-tile kpi-soft-yellow"><span class="label">Montant Banque</span><strong>{{ r.montantTotalBanque | number : '1.0-2' }}</strong></article>
            <article class="dashboard-kpi-tile kpi-soft-yellow"><span class="label">Montant {{ activeOperatorLabel }}</span><strong>{{ r.montantTotalOperateur | number : '1.0-2' }}</strong></article>
            <article class="dashboard-kpi-tile kpi-soft-yellow"><span class="label">Moy. Jour</span><strong>{{ r.moyenneJournaliereTransactions | number : '1.0-2' }}</strong></article>
            <article class="dashboard-kpi-tile kpi-soft-yellow"><span class="label">Pic Jour</span><strong>{{ r.picVolumeJournalier.totalTransactions }} ({{ r.picVolumeJournalier.businessDate || '-' }})</strong></article>
            <article class="dashboard-kpi-tile kpi-soft-orange"><span class="label">Debit a tort</span><strong>{{ r.debitATortCount }}</strong></article>
            <article class="dashboard-kpi-tile kpi-soft-red"><span class="label">Ecart Global</span><strong>{{ r.ecartGlobal | number : '1.0-2' }}</strong></article>
          </div>

          <div class="dashboard-grid" *ngIf="reportingSummary as report">
            <div class="dashboard-block">
              <h3>Distribution Reporting</h3>
              <div class="dist-row" *ngFor="let item of report.distribution">
                <span>{{ item.resultType }}</span>
                <div class="bar-wrap">
                  <div class="bar dist" [style.width.%]="(item.count * 100) / (report.kpis.totalTransactions || 1)"></div>
                </div>
                <b>{{ item.count }}</b>
              </div>
            </div>
            <div class="dashboard-block">
              <h3>Journalier</h3>
              <div class="timeline-row" *ngFor="let d of report.dailyBreakdown">
                <span>{{ d.businessDate }}</span>
                <div class="bar-wrap"><div class="bar tx" [style.width.%]="(d.totalTransactions * 100) / (report.kpis.picVolumeJournalier.totalTransactions || 1)"></div></div>
                <small>{{ d.totalTransactions }}</small>
                <small>{{ d.successRate | number : '1.0-2' }}%</small>
              </div>
            </div>
          </div>
        </div>

        <div class="dashboard-grid">
          <div class="dashboard-block">
            <h3>Distribution des resultats</h3>
            <div class="dist-row" *ngFor="let item of dashboardDistribution">
              <span>{{ item.resultType }}</span>
              <div class="bar-wrap">
                <div class="bar dist" [style.width.%]="(item.count * 100) / maxDistributionCount"></div>
              </div>
              <b>{{ item.count }}</b>
            </div>
          </div>

          <div class="dashboard-block">
            <h3>Timeline Horaire</h3>
            <div class="timeline-row" *ngFor="let point of dashboardTimeline">
              <span>{{ point.hour }}</span>
              <div class="bar-wrap">
                <div class="bar tx" [style.width.%]="(point.totalTransactions * 100) / maxTimelineTransactions"></div>
              </div>
              <small>{{ point.totalTransactions }}</small>
              <div class="bar-wrap anomaly">
                <div class="bar an" [style.width.%]="(point.anomalies * 100) / maxTimelineAnomalies"></div>
              </div>
              <small>{{ point.anomalies }}</small>
            </div>
          </div>
        </div>

        <div class="dashboard-grid">
          <div class="dashboard-block" *ngIf="dashboardDataQuality">
            <h3>Qualite des donnees</h3>
            <p>Imports: <b>{{ dashboardDataQuality.totalImports }}</b></p>
            <p>Lignes valides: <b>{{ dashboardDataQuality.validRows }}</b></p>
            <p>Lignes invalides: <b>{{ dashboardDataQuality.invalidRows }}</b></p>
            <p>Parsing Success: <b>{{ dashboardDataQuality.parsingSuccessRate | number : '1.0-2' }}%</b></p>
            <p>Duplicate Rate: <b>{{ dashboardDataQuality.duplicateRate | number : '1.0-2' }}%</b></p>
          </div>

          <div class="dashboard-block" *ngIf="dashboardAmounts">
            <h3>Montants</h3>
            <p>Banque: <b>{{ dashboardAmounts.montantGlobalBanque | number : '1.0-2' }}</b></p>
            <p>{{ activeOperatorLabel }}: <b>{{ dashboardAmounts.montantGlobalOperateur | number : '1.0-2' }}</b></p>
            <p>Anomalies: <b>{{ dashboardAmounts.montantAnomalies | number : '1.0-2' }}</b></p>
            <p>Ecart: <b>{{ dashboardAmounts.ecartGlobal | number : '1.0-2' }}</b></p>
          </div>
        </div>

        <div class="dashboard-block">
          <h3>Top anomalies</h3>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Key</th>
                  <th>Date</th>
                  <th>Type</th>
                  <th>Statut Banque</th>
                  <th>Statut {{ activeOperatorLabel }}</th>
                  <th>Montant Banque</th>
                  <th>Montant {{ activeOperatorLabel }}</th>
                  <th>Ecart</th>
                </tr>
              </thead>
              <tbody>
                <tr *ngFor="let row of dashboardTopAnomalies">
                  <td>{{ row.transactionKey }}</td>
                  <td>{{ row.businessDate }}</td>
                  <td>{{ row.resultType }}</td>
                  <td>{{ row.bankStatusRaw ?? '-' }}</td>
                  <td>{{ row.operatorStatusRaw ?? '-' }}</td>
                  <td>{{ row.bankAmount ?? '-' }}</td>
                  <td>{{ row.operatorAmount ?? '-' }}</td>
                  <td>{{ row.amountDifference ?? '-' }}</td>
                </tr>
                <tr *ngIf="dashboardTopAnomalies.length === 0">
                  <td colspan="8">Aucune anomalie critique.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

      </section>

      <section class="card dashboard-card full-page" *ngIf="activePage === 'COMPENSATION'">
        <h2>Compensation {{ activeOperatorLabel }}</h2>
        <div class="kpi-filter-bar">
          <label>
            Vue
            <select [(ngModel)]="compensationMode">
              <option [ngValue]="'DAILY'">Journaliere</option>
              <option [ngValue]="'WEEKLY'">Semaine (plage)</option>
              <option [ngValue]="'MONTHLY'">Mois (annee en cours)</option>
            </select>
          </label>

          <label *ngIf="compensationMode === 'DAILY'">
            Mode
            <select [(ngModel)]="compensationDateMode">
              <option [ngValue]="'SINGLE'">Jour unique</option>
              <option [ngValue]="'RANGE'">Entre deux dates</option>
            </select>
          </label>

          <label *ngIf="compensationMode === 'DAILY' && compensationDateMode === 'SINGLE'">Date transaction <input type="date" [(ngModel)]="compensationDate" /></label>
          <label *ngIf="compensationMode === 'DAILY' && compensationDateMode === 'RANGE'">Date debut <input type="date" [(ngModel)]="compensationDateFrom" /></label>
          <label *ngIf="compensationMode === 'DAILY' && compensationDateMode === 'RANGE'">Date fin <input type="date" [(ngModel)]="compensationDateTo" /></label>

          <label *ngIf="compensationMode === 'WEEKLY'">Date reference semaine <input type="date" [(ngModel)]="compensationWeekReferenceDate" /></label>

          <label *ngIf="compensationMode === 'MONTHLY'">Mois
            <select [(ngModel)]="compensationMonth">
              <option [ngValue]="1">Janvier</option><option [ngValue]="2">Fevrier</option><option [ngValue]="3">Mars</option>
              <option [ngValue]="4">Avril</option><option [ngValue]="5">Mai</option><option [ngValue]="6">Juin</option>
              <option [ngValue]="7">Juillet</option><option [ngValue]="8">Aout</option><option [ngValue]="9">Septembre</option>
              <option [ngValue]="10">Octobre</option><option [ngValue]="11">Novembre</option><option [ngValue]="12">Decembre</option>
