            <article class="dashboard-kpi-tile accounting-total"><span class="label">Total risques</span><strong>{{ riskTotalCount }}</strong></article>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Date</th><th>Cle</th><th>Reference operation</th><th>Type</th><th>Tel Operateur</th><th>Statut Banque</th><th>Statut Operateur</th><th>Montant Banque</th><th>Montant Operateur</th><th>Ecart</th><th>Motif</th>
                </tr>
