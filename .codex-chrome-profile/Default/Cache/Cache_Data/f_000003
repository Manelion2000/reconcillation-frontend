      <section class="card dashboard-card full-page accounting-page" *ngIf="activePage === 'ACCOUNTING'">
        <h2>Controle de comptabilisation</h2>
        <div class="kpi-filter-bar accounting-filter-bar">
          <label>Vue
            <select [(ngModel)]="accountingMode">
              <option [ngValue]="'DAILY'">Journalier</option>
              <option [ngValue]="'WEEKLY'">Hebdomadaire</option>
              <option [ngValue]="'MONTHLY'">Mensuel</option>
              <option [ngValue]="'RANGE'">Entre deux dates</option>
            </select>
          </label>
          <label *ngIf="accountingMode === 'DAILY'">Date <input type="date" [(ngModel)]="accountingDate" /></label>
          <label *ngIf="accountingMode === 'WEEKLY'">Date reference semaine <input type="date" [(ngModel)]="accountingWeekReferenceDate" /></label>
          <label *ngIf="accountingMode === 'RANGE'">Date debut <input type="date" [(ngModel)]="accountingDateFrom" /></label>
          <label *ngIf="accountingMode === 'RANGE'">Date fin <input type="date" [(ngModel)]="accountingDateTo" /></label>
          <label *ngIf="accountingMode === 'MONTHLY'">Mois
            <select [(ngModel)]="accountingMonth">
              <option [ngValue]="1">Janvier</option><option [ngValue]="2">Fevrier</option><option [ngValue]="3">Mars</option>
              <option [ngValue]="4">Avril</option><option [ngValue]="5">Mai</option><option [ngValue]="6">Juin</option>
              <option [ngValue]="7">Juillet</option><option [ngValue]="8">Aout</option><option [ngValue]="9">Septembre</option>
              <option [ngValue]="10">Octobre</option><option [ngValue]="11">Novembre</option><option [ngValue]="12">Decembre</option>
            </select>
          </label>
          <button class="primary" (click)="loadAccountingCheck()">Appliquer</button>
          <button class="secondary" (click)="exportAccountingKpiCsv()">Exporter KPI CSV</button>
          <button class="secondary" (click)="exportAccountingKpiPdf()">Exporter KPI PDF</button>
        </div>
        <div class="dashboard-kpi-strip">
          <article class="dashboard-kpi-tile kpi-soft-green"><span class="label">Comptabilise</span><strong>{{ comptabiliseCount }}</strong></article>
          <article class="dashboard-kpi-tile kpi-soft-red"><span class="label">Non Comptabilise</span><strong>{{ nonComptabiliseCount }}</strong></article>
          <article class="dashboard-kpi-tile kpi-soft-orange"><span class="label">Operations a risque</span><strong>{{ accountingRiskCount }}</strong></article>
          <article class="dashboard-kpi-tile accounting-total"><span class="label">Total</span><strong>{{ accountingRows.length }}</strong></article>
        </div>
        <div class="kpi-filter-bar accounting-filter-bar">
          <label>Statut
            <select [(ngModel)]="accountingStatusFilter">
              <option [ngValue]="'ALL'">Tous</option>
              <option [ngValue]="'COMPTABILISE'">Comptabilise</option>
              <option [ngValue]="'NON_COMPTABILISE'">Non comptabilise</option>
              <option [ngValue]="'A_RISQUE'">A risque</option>
            </select>
          </label>
          <label>Tel <input type="text" [(ngModel)]="accountingSearchPhone" placeholder="Recherche telephone" /></label>
          <label>Compte <input type="text" [(ngModel)]="accountingSearchAccount" placeholder="Recherche compte" /></label>
          <label>Reference <input type="text" [(ngModel)]="accountingSearchReference" placeholder="Recherche reference" /></label>
          <label>Transaction ID <input type="text" [(ngModel)]="accountingSearchTransactionId" placeholder="Recherche transaction" /></label>
        </div>
        <div class="dashboard-kpi-strip" *ngIf="accountingKpi as k">
          <article class="dashboard-kpi-tile kpi-soft-green">
            <span class="label">Volume total Carthago</span>
            <strong>{{ k.totalTransactions }}</strong>
            <small>Montant: {{ k.totalAmount | number : '1.0-2' }}</small>
          </article>
          <article class="dashboard-kpi-tile kpi-soft-green">
            <span class="label">Operations comptabilisees</span>
            <strong>{{ k.comptabilizedTransactions }}</strong>
            <small>Montant: {{ k.comptabilizedAmount | number : '1.0-2' }}</small>
            <small>Taux nb: {{ k.comptabilizationRateCount | number : '1.0-2' }}%</small>
            <small>Taux montant: {{ k.comptabilizationRateAmount | number : '1.0-2' }}%</small>
          </article>
          <article class="dashboard-kpi-tile kpi-soft-red">
            <span class="label">Operations non comptabilisees</span>
            <strong>{{ k.nonComptabilizedTransactions }}</strong>
            <small>Montant: {{ k.nonComptabilizedAmount | number : '1.0-2' }}</small>
            <small>Taux: {{ k.nonComptabilizationRateCount | number : '1.0-2' }}%</small>
            <small>Montant a risque: {{ k.amountAtRisk | number : '1.0-2' }}</small>
          </article>
          <article class="dashboard-kpi-tile kpi-soft-orange">
            <span class="label">Ecart financier</span>
            <strong>{{ k.netGapAmount | number : '1.0-2' }}</strong>
            <small>Ecart absolu total: {{ k.absoluteGapAmount | number : '1.0-2' }}</small>
            <small>Tx avec ecart: {{ k.transactionsWithGapCount }}</small>
            <small>Montant total ecarts: {{ k.totalGapAmount | number : '1.0-2' }}</small>
          </article>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
            <tr>
              <th>Date compta</th><th>Date valeur</th><th>Tel AMPLITUDE</th><th>Tel Carthago</th><th>Reference operation</th><th>Transaction ID</th><th>Date operation</th><th>Montant Carthago</th><th>Credit AMPLITUDE</th><th>Compte</th><th>Statut</th>
            </tr>
            </thead>
            <tbody>
            <tr *ngFor="let row of filteredAccountingRows">
              <td>{{ row.accountingDateRaw || '-' }}</td>
              <td>{{ row.valueDateRaw || '-' }}</td>
              <td>{{ row.phoneNumber || '-' }}</td>
              <td>{{ row.bankPhoneNumber || '-' }}</td>
              <td>{{ row.operationReference || '-' }}</td>
              <td>{{ row.transactionId }}</td>
              <td>{{ row.operationDate || '-' }}</td>
              <td>{{ row.amount ?? '-' }}</td>
              <td>{{ row.amplitudeCredit ?? '-' }}</td>
              <td>{{ row.accountNumber || '-' }}</td>
              <td>
                <span class="status-pill" [ngClass]="row.status === 'COMPTABILISE' ? 'ok' : 'ko'">{{ row.status }}</span>
              </td>
            </tr>
            <tr *ngIf="filteredAccountingRows.length === 0"><td colspan="11">Aucune donnee sur la periode.</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>
</div>

<div class="upload-modal-backdrop" *ngIf="uploadDialogOpen" (click)="closeUploadDialog()">
  <section class="upload-modal" (click)="$event.stopPropagation()">
    <header class="upload-modal-header">
      <div>
        <span class="modal-eyebrow">Import fichiers</span>
        <h2 *ngIf="uploadDialogMode === 'RECONCILIATION'">Upload Banque / {{ activeOperatorLabel }}</h2>
        <h2 *ngIf="uploadDialogMode === 'ACCOUNTING'">Upload AMPLITUDE</h2>
        <p *ngIf="uploadDialogMode === 'RECONCILIATION'">Chargez les fichiers puis lancez la reconciliation depuis cette fenetre.</p>
        <p *ngIf="uploadDialogMode === 'ACCOUNTING'">Chargez le fichier AMPLITUDE pour le controle de comptabilisation.</p>
      </div>
      <button class="modal-close" type="button" (click)="closeUploadDialog()" [disabled]="loading" aria-label="Fermer">X</button>
    </header>

    <div class="upload-modal-body" *ngIf="uploadDialogMode === 'RECONCILIATION'">
      <div class="upload-form-grid">
        <label>Date metier <input type="date" [(ngModel)]="businessDate" /></label>
        <label>Label run <input type="text" [(ngModel)]="runLabel" placeholder="RUN-YYYY-MM-DD" /></label>
        <label>Fichier Banque <input #bankFileInput type="file" (change)="onBankFile($event)" /></label>
        <label *ngIf="selectedOperator === 'MOOV'">Fichier Moov <input #moovFileInput type="file" (change)="onMoovFile($event)" /></label>
        <label *ngIf="selectedOperator === 'ORANGE'">Fichier Orange <input #orangeFileInput type="file" (change)="onOrangeFile($event)" /></label>
      </div>
      <div class="selected-files" *ngIf="selectedBankFileName || selectedMoovFileName || selectedOrangeFileName">
        <small *ngIf="selectedBankFileName">Banque: {{ selectedBankFileName }}</small>
        <small *ngIf="selectedOperator === 'MOOV' && selectedMoovFileName">Moov: {{ selectedMoovFileName }}</small>
        <small *ngIf="selectedOperator === 'ORANGE' && selectedOrangeFileName">Orange: {{ selectedOrangeFileName }}</small>
      </div>
      <div class="actions modal-actions">
        <button class="primary" type="button" (click)="importBankOnly()" [disabled]="loading">Uploader Banque</button>
        <button class="primary" type="button" (click)="importSelectedOperator()" [disabled]="loading">Uploader {{ activeOperatorLabel }}</button>
        <button class="secondary" type="button" (click)="runReconciliation()" [disabled]="loading">Lancer reconciliation {{ activeOperatorLabel }}</button>
        <button class="ghost" type="button" (click)="loadRuns()" [disabled]="loading">Actualiser</button>
      </div>
    </div>

    <div class="upload-modal-body" *ngIf="uploadDialogMode === 'ACCOUNTING'">
      <div class="upload-form-grid">
        <label>Date metier <input type="date" [(ngModel)]="businessDate" /></label>
        <label>Fichier AMPLITUDE <input #amplitudeFileInput type="file" (change)="onAmplitudeFile($event)" /></label>
      </div>
      <div class="selected-files" *ngIf="amplitudeFile">
        <small>AMPLITUDE: {{ amplitudeFile.name }}</small>
      </div>
      <div class="actions modal-actions">
        <button class="primary" type="button" (click)="importAmplitudeOnly()" [disabled]="loading">Uploader AMPLITUDE</button>
      </div>
    </div>
  </section>
</div>

<div class="dialog-backdrop" *ngIf="dialogOpen" (click)="closeDialog()">
  <div class="dialog" [ngClass]="dialogKind" (click)="$event.stopPropagation()">
    <h3>{{ dialogTitle }}</h3>
    <p>{{ dialogMessage }}</p>
    <div class="dialog-actions"><button class="primary" (click)="closeDialog()">OK</button></div>
  </div>
</div>
